      "turns": [
        {"inbound": true, "text": "I cannot log in to my account"},
        {"inbound": false, "text": "Sorry to hear that, what do you see?"},
        {"inbound": true, "text": "the password reset fails every time"}
      ],
      "expected": {"intent": "account_access", "action": "route", "should_escalate": false},
