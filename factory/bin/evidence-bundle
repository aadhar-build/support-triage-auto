#!/usr/bin/env python3
"""Export selected job or weekly evidence to a new offline directory."""
import argparse
import sys
from pathlib import Path
from zoneinfo import ZoneInfoNotFoundError

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import factory as F
from evidence_bundle import BundleError, export_job
from scorecard_source import utc_cutoff, weekly_start
from weekly_evidence import export_week


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("job_id", nargs="?")
    parser.add_argument("--include", action="append", default=[], metavar="evidence/check-N.json")
    parser.add_argument("--gate", metavar="round-N/checks.md@SHA256")
    parser.add_argument("--artifact", action="append", default=[], metavar="PATH@SHA256",
                        help="project a native gate, code/security/eval review, or technical decision")
    parser.add_argument("--overview", action="store_true",
                        help="show local job stage, candidate and missing or unselected evidence")
    parser.add_argument("--private-owner-view", action="store_true",
                        help="include private job labels and decisions in a local owner-only page")
    parser.add_argument("--weekly", type=weekly_start, metavar="YYYY-MM-DD", help="start of the reporting week")
    parser.add_argument("--timezone", metavar="IANA", help="time zone for weekly cohort boundaries")
    parser.add_argument("--as-of", type=utc_cutoff, metavar="UTC", help="recording-time cutoff for weekly observations")
    parser.add_argument("--defect-window-days", type=int, metavar="N", help="escaped-defect follow-up window")
    parser.add_argument("--weekly-evidence", action="append", default=[], metavar="JOB_ID:PATH@SHA256",
                        help="project a native artifact from an active job in the week")
    parser.add_argument("--output", required=True, type=Path, metavar="NEW_DIRECTORY")
    args = parser.parse_args()
    if args.weekly is None:
        if not args.job_id or args.weekly_evidence or any(value is not None for value in
                                                         (args.timezone, args.as_of, args.defect_window_days)):
            parser.error("choose a job ID for job export or use --weekly for weekly options")
        if args.private_owner_view and args.overview:
            parser.error("--private-owner-view and --overview are separate job views")
    else:
        if args.job_id or args.include or args.gate or args.artifact or args.overview or args.private_owner_view:
            parser.error("--weekly cannot be combined with single-job options")
        if args.as_of is None:
            parser.error("--weekly requires an explicit --as-of cutoff")
        if args.defect_window_days is not None and args.defect_window_days <= 0:
            parser.error("--defect-window-days must be positive")
    try:
        root = F.repo_root()
        if args.weekly is None:
            export_job(root, args.job_id, args.output, args.include, args.gate,
                       artifacts=args.artifact, overview=args.overview, private_owner_view=args.private_owner_view)
        else:
            export_week(root, args.weekly, args.as_of, args.timezone, args.defect_window_days,
                        args.output, args.weekly_evidence)
    except ZoneInfoNotFoundError:
        parser.error("unknown reporting time zone")
    except (BundleError, F.FactoryError) as error:
        parser.exit(1, f"{error}\n")
    print("Wrote index.html and manifest.json in the selected directory.")


if __name__ == "__main__":
    main()
